{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "research": {
        "type": "local",
        "command": ["bash", "scripts/python.sh", "-m", "metac_bot.research_mcp"],
        "timeout": { "startup": 60000, "execution": 660000 }
      },
      "metaculus": {
        "type": "local",
        "command": ["bash", "scripts/python.sh", "-m", "metac_bot.mcp_server"],
        "timeout": { "startup": 60000 }
      }
    }
  }
}
