# Copy to .env. The Python runner loads it; never commit real credentials.
METACULUS_TOKEN=REPLACE_ME

# Explicit bot settings override OpenCode defaults; CLI options take precedence.
# A model override is optional; omitted means OpenCode's configured default.
# OPENCODE_MODEL=openrouter/openai/gpt-4.1-mini
# METAC_BOT_SESSION_TIMEOUT=900
# METAC_BOT_ENSEMBLE_CONCURRENCY=2
# OPENCODE_SEARCH_PROVIDER=random
# An explicit OPENROUTER_API_KEY uses an isolated service and private account.
# Other saved provider accounts are not available there; use environment keys.

# Optional explicit server connection instead of local service discovery. It
# cannot be combined with OPENROUTER_API_KEY or OPENCODE_SEARCH_PROVIDER overrides.
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=REPLACE_ME
# OPENCODE_SERVICE_FILE=/path/to/opencode/state/service.json

# GITHUB ACTIONS: set these as repository secrets. The workflow supplies them
# to OpenCode BEFORE starting its service. Set at least one model provider.
# Model, search provider, session timeout and concurrency are set through
# Actions variables or manual workflow inputs; see README.md.
# OPENROUTER_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME

# OpenCode-native search providers (set whichever you use).
# EXA_API_KEY=REPLACE_ME
# TAVILY_API_KEY=REPLACE_ME
# FIRECRAWL_API_KEY=REPLACE_ME
# PARALLEL_API_KEY=REPLACE_ME
# TINYFISH_API_KEY=REPLACE_ME

# Optional research MCP tools. Locally, these can be set in this .env; the MCP
# process loads it when connecting. Reconnect the research server after edits.
# GitHub: set matching repository secrets; workflows pass them to OpenCode.
# ASKNEWS_API_KEY=REPLACE_ME
# Or use AskNews OAuth credentials instead:
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# PERPLEXITY_API_KEY=REPLACE_ME
# EXA_API_KEY above also enables the Exa MCP tool.

# Optional integrations; see integrations/README.md.
# LIGHTNINGROD_API_KEY=REPLACE_ME
